# ── 客户端环境变量（前缀 EXPO_PUBLIC_ 会暴露给客户端，不放密钥）────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 错误监控(可选):在 sentry.io 建一个 React Native 项目后把 DSN 填在这里。
# DSN 本来就是公开值(只能写入事件,不能读取),可以放在客户端。留空 = 不上报。
# 在 Vercel 里同名设置为环境变量,并重新部署。
EXPO_PUBLIC_SENTRY_DSN=

# ── 服务端密钥（存储在 Supabase Edge Function Secrets，不放在此文件）──────────
# 在 Supabase Dashboard > Edge Functions > Secrets 中设置：
#   ANTHROPIC_API_KEY = sk-ant-your-key-here
#
# 部署 Edge Function：
#   supabase functions deploy analyze-round
